# Copy this template when running the agent service on the host machine.
# Render to configuration/env_files/local/local-development.env.
# The rendered file is ignored by git and may contain local secrets.

UVICORN_HOST=0.0.0.0
UVICORN_PORT=8080
UVICORN_LOG_LEVEL=info
UVICORN_RELOAD=True
UVICORN_LOG_CONFIG_PATH=./llm_agent/configuration/log_config_json.json
ENV_TYPE=development
PICCOLO_CONF=llm_agent.infrastructure.db.piccolo_conf

DI_REGISTRAR_PROVIDER=tests.fake_implementations.llm_agent.di.app_registrar_providers.get_development_registrars

OTEL_SERVICE_NAME=movie-agent-worker
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=service.environment=local,demo.name=multi-service-observability
MOVIE_RESERVATION_MCP_URL=http://127.0.0.1:8091/mcp
AXUM_TOOLS_MCP_URL=http://127.0.0.1:8092/mcp

# Set DEMO_LLM_PROVIDER=openrouter and add OPENROUTER_API_KEY in the rendered file.
DEMO_LLM_PROVIDER=none
DEMO_LLM_MODEL=openrouter/auto
DEMO_LLM_TIMEOUT_SECONDS=20
DEMO_LLM_MAX_TOKENS=128
DEMO_LLM_TEMPERATURE=0
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8080
OPENROUTER_APP_TITLE=python-agent-with-idp
OPENROUTER_ALLOWED_MODELS=
OPENROUTER_AUTO_COST_QUALITY_TRADEOFF=7

# There is no database for the current demo runtime.
#PICCOLO_DB_HOST=localhost
#PICCOLO_DB_PORT=5432
#PICCOLO_DB_USER=postgres
#PICCOLO_DB_PASSWORD=postgres
#PICCOLO_DB_DATABASE=postgres
